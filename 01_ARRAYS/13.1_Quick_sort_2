#include <iostream>
using namespace std;
// QUICKSORT using 1st element as a pivot
// l is Left side 
// r is Right side
// p is pivot
int partition(int arr[], int l, int r) {
	int p = arr[l];
	int i = l+1;
	int j =r;
	while (i<=j) {
		while(i<=r && arr[i]<=p) {
			i++;
		}
		while(j >= l && arr[j] > p) {
			j--;
		}
		if (i<j) {
			swap(arr[i], arr[j]);
		}
	}
	swap (arr[l],arr[j]);
	return j;
}
void quicksort(int arr[], int l,int r) {
	if (l<r) {
		int p = partition(arr, l,r);
		quicksort(arr, l, p -1);
		quicksort(arr, p+1, r);

	}

}

int main() {
	int arr[5]= {73,123,531,993,1};

	quicksort(arr,0, 4);
	for(int i =0; i<5 ; i++) {
		cout<<arr[i]<<" ";
	}
	return 0;
}
